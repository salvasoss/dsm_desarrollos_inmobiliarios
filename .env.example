# Número internacional de DSM. Solo dígitos, con código de país.
# Para un celular argentino: 549 + código de área + número, sin 0 ni 15.
# Vacío: muestra la consulta para revisar/copiar, sin enviarla.
VITE_WHATSAPP_NUMBER=

# Dominio definitivo para enlaces y metadatos (sin barra final).
VITE_SITE_URL=

# Video o playlist del canal de DSM para el popup de todas las fichas.
# Cada obra puede tener su propio youtubeTourUrl en src/data/duplexes.js.
VITE_YOUTUBE_TOUR_URL=
